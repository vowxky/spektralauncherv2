{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "Spektra",
  "version": "1.0.8",
  "identifier": "Spektra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spektra",
        "width": 1080,
        "height": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "x": null,
        "y": null,
        "theme": "Dark",
        "create": false,
        "visible": false,
        "backgroundColor": "#000000"
      },
      {
        "label": "logs",
        "title": "Logs — Spektra",
        "width": 900,
        "height": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "theme": "Dark",
        "create": false,
        "visible": false,
        "backgroundColor": "#0a0a0c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http: asset: http://asset.localhost; media-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "licenseFile": "./LICENSE.rtf",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": []
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFNDA5NkVBQTAyRjZBQzAKUldUQWFpK2c2cFpBL25oVjNKYmR4V0VJMU00UFlzeGtXVUMzSENVdVdSTys2TVF6OFJlL1dTaHMK",
      "endpoints": [
        "https://cdn.stackedhost.crysistudio.xyz/spektra/release/latest/update.json"
      ]
    }
  }
}
